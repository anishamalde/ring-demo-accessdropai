# Copy to .env and fill in. .env is gitignored, never commit it.

# --- Browser (Vite exposes VITE_* vars to the client bundle) ---
# Ring AVA OAuth tokens (access token expires every 4 hours)
VITE_RING_ACCESS_TOKEN=
VITE_RING_REFRESH_TOKEN=
# Partner credentials (issued during onboarding)
VITE_RING_CLIENT_ID=
VITE_RING_CLIENT_SECRET=
# Ring API base, used to rewrite WHEP session URLs through the proxy
VITE_RING_API_BASE_URL=https://api.amazonvision.com
# Local proxy the browser talks to
VITE_PROXY_URL=http://localhost:3001

# --- Proxy server (proxy-server.js) ---
RING_API_BASE_URL=https://api.amazonvision.com
RING_OAUTH_URL=https://oauth.ring.com
PROXY_HOST=127.0.0.1
PROXY_PORT=3001
# Comma-separated origins allowed to call the proxy
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
